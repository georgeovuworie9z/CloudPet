# CloudPet environment configuration — EXAMPLE.
# Copy to `.env` (which is git-ignored) and set real values locally.
# Never commit `.env` or real secrets.

# Runtime environment: local | test | staging | production
ENVIRONMENT=local

# PostgreSQL connection (SQLAlchemy + psycopg driver).
# Local, non-Docker use points at localhost. When running via docker compose,
# the api service overrides this to reach the `db` service directly.
# When ENVIRONMENT=production, this must include sslmode=require (or stronger),
# e.g. postgresql+psycopg://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql+psycopg://cloudpet:cloudpet@localhost:5432/cloudpet

# HS256 signing key for application-managed JWT auth. Must be at least 32
# characters and must not be left as the placeholder below -- both are rejected
# at startup. Generate a strong random value, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=replace-with-a-strong-random-secret

# Access token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# AWS S3 object storage (pet images arrive in a later milestone). All optional:
# the application runs without them until the storage layer is used.
# AWS credentials are NOT configured here — boto3 resolves them from its provider
# chain (AWS profile / SSO locally, IAM instance role on EC2).
# S3_BUCKET_NAME=
# AWS_REGION=
# S3_ENDPOINT_URL=

# Level for CloudPet's own application logs (Uvicorn's own request/access
# logging is separate and unaffected). One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO
